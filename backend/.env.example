PORT=5000
NODE_ENV=development
DASHBOARD_TIME_ZONE=Asia/Kolkata

MONGODB_URI=
# Legacy JWT setting; opaque cookie sessions do not require it.
JWT_SECRET=

# Required for kiosk JWT signing and verification. Generate with:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
KIOSK_TOKEN_SECRET=

# Optional: platform-wide database/Atlas metrics are restricted to these
# explicitly authorized owner IDs. Leave empty for tenant-only access.
PLATFORM_ADMIN_OWNER_IDS=
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=

FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:5000

# Gmail SMTP (use a Google App Password; never use your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SS Fitness Manager <your-email@gmail.com>

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Required for private, authenticated expense receipt uploads and signed downloads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Legacy unsigned-upload preset setting; expense receipts use server-signed uploads instead.
CLOUDINARY_UPLOAD_PRESET=

# Legacy encryption utility only; this does not configure kiosk enrollment.
BIOMETRIC_ENCRYPTION_KEY=
BIOMETRIC_ENCRYPTION_KEY_VERSION=1

# Face-template encryption key. Keep stable while encrypted templates exist.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# Set locally in backend/.env and in Render's backend environment; never in frontend config.
BIOMETRIC_TEMPLATE_KEY=
BIOMETRIC_KEY_VERSION=v1
