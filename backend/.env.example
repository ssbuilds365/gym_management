PORT=5000
NODE_ENV=development
DASHBOARD_TIME_ZONE=Asia/Kolkata

MONGODB_URI=
# Legacy JWT setting; opaque cookie sessions do not require it.
JWT_SECRET=

# Optional: platform-wide database/Atlas metrics are restricted to these
# explicitly authorized owner IDs. Leave empty for tenant-only access.
PLATFORM_ADMIN_OWNER_IDS=
ATLAS_PUBLIC_KEY=
ATLAS_PRIVATE_KEY=
ATLAS_PROJECT_ID=
ATLAS_CLUSTER_NAME=

FRONTEND_URL=http://localhost:4200
BACKEND_URL=http://localhost:5000

# Gmail SMTP (use a Google App Password; never use your account password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=SS Fitness Manager <your-email@gmail.com>

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Required for private, authenticated expense receipt uploads and signed downloads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Legacy unsigned-upload preset setting; expense receipts use server-signed uploads instead.
CLOUDINARY_UPLOAD_PRESET=

# Generate a 32-byte key encoded as Base64 and keep it in the secret manager.
BIOMETRIC_ENCRYPTION_KEY=
BIOMETRIC_ENCRYPTION_KEY_VERSION=1
